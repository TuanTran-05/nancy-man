[Unit]
Description=EduTrack guarded configuration agent
After=local-fs.target
Before=edutrack-ops-api.service
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=simple
User=edutrack-config-agent
Group=edutrack-config-api
SupplementaryGroups=edutrack-config-agent edutrack-ops deploy
WorkingDirectory=/srv/edutrack-ops/config-agent/current
EnvironmentFile=/etc/edutrack-ops/config-agent.env
Environment=OPS_CONFIG_AGENT_SOCKET_PATH=/run/edutrack-config-agent/agent.sock
Environment=OPS_CONFIG_AGENT_SOCKET_MODE=0660
Environment=OPS_CONFIG_AGENT_SOCKET_GROUP=edutrack-config-api
Environment=OPS_CONFIG_AGENT_PROTOCOL_KEY_PATH=%d/config-agent-protocol-hmac
Environment=OPS_CONFIG_AGENT_PROTOCOL_KEY_ID=config-agent-2026-08-31
Environment=OPS_CONFIG_AGENT_FINGERPRINT_KEY_PATH=%d/config-agent-fingerprint-hmac
Environment=OPS_CONFIG_AGENT_FINGERPRINT_KEY_VERSION=v1
Environment=OPS_CONFIG_AGENT_STAGING_KEY_PATH=%d/config-agent-staging-key
Environment=OPS_CONFIG_AGENT_STAGING_KEY_ID=config-agent-staging-2026-08-31
Environment=OPS_CONFIG_AGENT_STAGING_KEY_VERSION=v1
Environment=OPS_CONFIG_AGENT_SNAPSHOT_KEY_PATH=%d/config-agent-snapshot-key
Environment=OPS_CONFIG_AGENT_SNAPSHOT_KEY_ID=config-agent-snapshot-2026-08-31
Environment=OPS_CONFIG_AGENT_SNAPSHOT_KEY_VERSION=v1
Environment=OPS_CONFIG_AGENT_MANIFEST_PATH=/srv/edutrack-ops/config-agent/current/deploy/ops/config-agent/manifest.yaml
Environment=OPS_CONFIG_AGENT_CATALOG_PATH=/srv/edutrack-ops/config-agent/current/config/variables/catalog.yaml
LoadCredential=config-agent-protocol-hmac:/etc/edutrack-ops/credentials/config-agent-protocol-hmac
LoadCredential=config-agent-fingerprint-hmac:/etc/edutrack-ops/credentials/config-agent-fingerprint-hmac
LoadCredential=config-agent-staging-key:/etc/edutrack-ops/credentials/config-agent-staging-key
LoadCredential=config-agent-snapshot-key:/etc/edutrack-ops/credentials/config-agent-snapshot-key
RuntimeDirectory=edutrack-config-agent
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/node /srv/edutrack-ops/config-agent/current/apps/config-agent/dist/apps/config-agent/src/index.js
Restart=on-failure
RestartSec=5s
TimeoutStartSec=15s
TimeoutStopSec=15s
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=false
LimitNOFILE=4096
MemoryMax=256M
TasksMax=64
StandardOutput=journal
StandardError=journal
LogLevelMax=notice
LogRateLimitIntervalSec=30s
LogRateLimitBurst=20

# Mutation writes remain explicit and are constrained by the manifest.
ReadWritePaths=/var/lib/edutrack-config-agent
ReadWritePaths=/srv/edutrack/shared
ReadWritePaths=/etc/edutrack-ops
ReadWritePaths=/srv/edutrack/staging
ReadWritePaths=/srv/edutrack/current
ReadWritePaths=/srv/edutrack/releases
ReadOnlyPaths=/srv/edutrack-ops/config-agent/current
ReadOnlyPaths=/etc/beszel/hub/hub.env
ReadOnlyPaths=/etc/beszel/agent.env

[Install]
WantedBy=multi-user.target
