[Unit]
Description=EduTrack Operations monitoring web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edutrack-ops-web
Group=edutrack-ops-shared
UMask=0007
WorkingDirectory=/srv/edutrack-ops/current/apps/web
EnvironmentFile=/etc/edutrack-ops/web.env
Environment=OPS_LEGACY_MONITORING_HMAC_FILE=%d/ops-legacy-monitoring-hmac
LoadCredential=ops-legacy-monitoring-hmac:/etc/edutrack-ops/credentials/ops-legacy-monitoring-hmac
ExecStart=/usr/bin/node dist/server/web-server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/edutrack-ops/shared
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
