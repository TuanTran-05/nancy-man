[Unit]
Description=EduTrack Operations Error Processor
After=network-online.target edutrack-ops-api.service
Wants=network-online.target

[Service]
Type=simple
User=edutrack-ops-processor
Group=edutrack-ops-processor
WorkingDirectory=/srv/edutrack-ops/current
EnvironmentFile=/etc/edutrack-ops/api.env
Environment=OPS_SECRET_DIRECTORY=%d
LoadCredential=ops-database-url:/etc/edutrack-ops/credentials/ops-database-url
ExecStartPre=+/usr/bin/chmod 0400 %d/ops-database-url
ExecStart=/usr/bin/node apps/processor/dist/apps/processor/src/runtime/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
