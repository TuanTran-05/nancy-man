[Unit]
Description=EduTrack Operations private SQL worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=edutrack-ops-sql-worker
Group=edutrack-ops-sql
WorkingDirectory=/srv/edutrack-ops/current
EnvironmentFile=/etc/edutrack-ops/sql-worker.env
Environment=OPS_SECRET_DIRECTORY=%d
LoadCredential=ops-sql-worker-hmac:/etc/edutrack-ops/credentials/ops-sql-worker-hmac
LoadCredential=ops-telemetry-hmac:/etc/edutrack-ops/credentials/ops-telemetry-hmac
LoadCredential=ops-database-edutrack-reader-url:/etc/edutrack-ops/credentials/ops-database-edutrack-reader-url
LoadCredential=ops-database-ops-reader-url:/etc/edutrack-ops/credentials/ops-database-ops-reader-url
LoadCredential=ops-database-cursor-key:/etc/edutrack-ops/credentials/ops-database-cursor-key
LoadCredential=ops-database-policy-approval:/etc/edutrack-ops/credentials/ops-database-policy-approval
RuntimeDirectory=edutrack-ops
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/node apps/sql-worker/dist/apps/sql-worker/src/index.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/edutrack-ops
ReadWritePaths=/var/lib/edutrack-ops/telemetry/sql-worker
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
