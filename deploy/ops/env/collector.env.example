# Copy to /etc/edutrack-ops/collector.env with mode 0640, owned by root.
# Fill empty secret placeholders only in that host-owned file; never commit them.
NODE_ENV=production
OPS_DB_PATH=/srv/edutrack-ops/shared/ops.sqlite
OPS_APP_URL=http://127.0.0.1:3101
OPS_MONITOR_DATABASE_URL=
OPS_PM2_PID_PATH=
OPS_PM2_ERROR_LOG_PATH=/srv/edutrack/shared/logs/app-error.log
OPS_CRON_LOG_PATH=/srv/edutrack/shared/logs/cron.log
OPS_BACKUP_DIR=/srv/edutrack/shared/backups/postgres
OPS_ALERT_ZALO_BOT_TOKEN=
OPS_ALERT_ZALO_RECIPIENT_UIDS=
OPS_ZALO_CHAT_HASH_SECRET=
OPS_ZALO_RECIPIENT_KEY=
OPS_ALERT_ZALO_TIMEOUT_MS=10000
OPS_BESZEL_ENABLED=false
OPS_BESZEL_URL=http://127.0.0.1:8090
OPS_BESZEL_USER=ops-telemetry@thienuy.invalid
OPS_BESZEL_SYSTEM_ID=
OPS_BESZEL_TIMEOUT_MS=5000
