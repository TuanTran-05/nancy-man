# This file belongs at /etc/edutrack-ops/api.env with mode 0640, owned by root.
# It contains no database URL or secret value. systemd injects credential files.
OPS_PUBLIC_URL=https://man.thienuy.edu.vn
OPS_API_HOST=127.0.0.1
OPS_API_PORT=3100
OPS_DATABASE_URL_REFERENCE=ops-database-url
OPS_SESSION_PEPPER_REFERENCE=ops-session-pepper
OPS_RATE_LIMIT_PEPPER_REFERENCE=ops-rate-limit-pepper
OPS_AUTH_SESSION_PEPPER_REFERENCE=ops-auth-session-pepper
OPS_MFA_ENCRYPTION_KEY_REFERENCE=ops-mfa-encryption-key
OPS_PASSWORD_FINGERPRINT_PEPPER_REFERENCE=ops-password-fingerprint-pepper
OPS_LEGACY_MONITORING_HMAC_REFERENCE=ops-legacy-monitoring-hmac
OPS_VARIABLES_READ_ONLY_ENABLED=false
OPS_VARIABLES_DRAFT_ENABLED=false
OPS_VARIABLES_RUNTIME_APPLY_ENABLED=false
OPS_VARIABLES_BUILD_APPLY_ENABLED=false
OPS_CONFIG_AGENT_SOCKET_PATH=/run/edutrack-config-agent/agent.sock
OPS_CONFIG_AGENT_HMAC_REFERENCE=config-agent-protocol-hmac
OPS_CONFIG_AGENT_HMAC_KEY_ID=config-agent-2026-08-31
OPS_CONFIG_AGENT_MANIFEST_VERSION=2026-09-01
OPS_CONFIG_AGENT_CATALOG_VERSION=2026-08-31
OPS_CONFIG_AGENT_CATALOG_DIGEST=sha256:1783d0cf20b045679dd584fad52b8995a2bd40cfa8f5e179fd99f4977d4c1bf6
OPS_CONFIG_AGENT_CONNECT_TIMEOUT_MS=500
OPS_CONFIG_AGENT_READ_TIMEOUT_MS=1000
OPS_CONFIG_AGENT_TOTAL_TIMEOUT_MS=2000
OPS_CONFIG_AGENT_MAX_RESPONSE_BYTES=1048576
OPS_VARIABLES_CATALOG_PATH=/srv/edutrack-ops/current/config/variables/catalog.yaml
OPS_BROWSER_CONTEXT_KEY_ID=edutrack-browser-v1
OPS_BROWSER_CONTEXT_KEY_REFERENCE=browser-context-edutrack-v1
OPS_OBJECT_STORE_DIRECTORY=/var/lib/edutrack-ops/object-store
OPS_BROWSER_CORS_ORIGINS=https://thienuy.edu.vn
OPS_PROCESSOR_POLL_MS=250
OPS_NOTIFIER_POLL_MS=1000
# Delivery remains dark-launched: no provider credential is configured yet.
# Keep the API-to-worker bridge disabled until the private socket, shared HMAC,
# dedicated SQL-audit encryption key, and read-only PostgreSQL role have passed
# the Phase 3 deployment gate. Do not reuse the MFA encryption key.
OPS_SQL_WORKER_ENABLED=false
# The following flags are retained as rollout documentation. The SQL worker's
# own environment controls whether it is allowed to resolve a production reader.
OPS_SQL_READ_ENABLED=false
OPS_SQL_MUTATION_ENABLED=false
OPS_SQL_DDL_ENABLED=false
OPS_SQL_BREAK_GLASS_ENABLED=false
