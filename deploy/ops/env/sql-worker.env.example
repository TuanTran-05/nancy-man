# This file belongs at /etc/edutrack-ops/sql-worker.env with mode 0640, owned by root.
# It contains no database URL or secret value. systemd injects credential files.
OPS_SECRET_DIRECTORY=/run/credentials/edutrack-ops-sql-worker.service
OPS_SQL_SOCKET_PATH=/run/edutrack-ops/sql-worker.sock
OPS_SQL_WORKER_HMAC_REFERENCE=ops-sql-worker-hmac
# The worker starts with no production database credential or connection.
OPS_SQL_READ_ENABLED=false
OPS_SQL_MUTATION_ENABLED=false
