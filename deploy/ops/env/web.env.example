# Copy to /etc/edutrack-ops/web.env with mode 0640, owned by root.
# Fill empty secret placeholders only in that host-owned file; never commit them.
NODE_ENV=production
OPS_DB_PATH=/srv/edutrack-ops/shared/ops.sqlite
OPS_DATA_KEY=
OPS_LISTEN_HOST=127.0.0.1
OPS_PORT=3101
OPS_ALERT_ZALO_BOT_TOKEN=
OPS_ZALO_WEBHOOK_SECRET=
OPS_ZALO_LINK_CODE_PEPPER=
OPS_ZALO_CHAT_HASH_SECRET=
OPS_ZALO_RECIPIENT_KEY=
OPS_ALERT_ZALO_TIMEOUT_MS=10000
OPS_ZALO_LINK_TTL_SECONDS=600
# systemd supplies this file through LoadCredential; do not put the HMAC here.
OPS_LEGACY_MONITORING_HMAC_FILE=/run/credentials/edutrack-ops-web.service/ops-legacy-monitoring-hmac
