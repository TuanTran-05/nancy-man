# Copy to /etc/edutrack-ops/web.env with mode 0640, owned by root.
# Fill empty secret placeholders only in that host-owned file; never commit them.
NODE_ENV=production
OPS_DB_PATH=/srv/edutrack-ops/shared/ops.sqlite
OPS_DATA_KEY=
OPS_LISTEN_HOST=127.0.0.1
OPS_PORT=3101
OPS_ALERT_ZALO_BOT_TOKEN=
OPS_ZALO_WEBHOOK_SECRET=
OPS_ZALO_LINK_CODE_PEPPER=
OPS_ZALO_CHAT_HASH_SECRET=
OPS_ZALO_RECIPIENT_KEY=
OPS_ALERT_ZALO_TIMEOUT_MS=10000
OPS_ZALO_LINK_TTL_SECONDS=600
# systemd supplies this file through LoadCredential; do not put the HMAC here.
OPS_LEGACY_MONITORING_HMAC_FILE=/run/credentials/edutrack-ops-web.service/ops-legacy-monitoring-hmac
VITE_OPS_BROWSER_TELEMETRY_ENABLED=true
VITE_OPS_BROWSER_INGEST_URL=https://man.thienuy.edu.vn/api/v1/ingest/browser
VITE_OPS_BROWSER_PROJECT_KEY=ops-web-public-key
VITE_APP_RELEASE_SHA=0000000000000000000000000000000000000000
OPS_TELEMETRY_ENABLED=true
OPS_TELEMETRY_INGEST_URL=https://man.thienuy.edu.vn/api/v1/ingest/server
OPS_TELEMETRY_KEY_ID=edutrack-ops-runtime
OPS_TELEMETRY_HMAC_SECRET_REFERENCE=ops-telemetry-hmac
OPS_TELEMETRY_HMAC_FILE=/run/credentials/edutrack-ops-web.service/ops-telemetry-hmac
OPS_TELEMETRY_RELEASE=0000000000000000000000000000000000000000
OPS_TELEMETRY_SPOOL_ROOT=/var/lib/edutrack-ops/telemetry
OPS_TELEMETRY_SPOOL_DIRECTORY=/var/lib/edutrack-ops/telemetry
