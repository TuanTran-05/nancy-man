# Install as /etc/edutrack-ops/config-agent.env, owned by root:edutrack-ops, mode 0640.
# This example is intentionally dark-launched and contains no credential value.
OPS_CONFIG_AGENT_ENABLED=false
OPS_CONFIG_AGENT_SOCKET_PATH=/run/edutrack-config-agent/agent.sock
OPS_CONFIG_AGENT_SOCKET_MODE=0660
OPS_CONFIG_AGENT_SOCKET_GROUP=edutrack-config-api
OPS_CONFIG_AGENT_PROTOCOL_HMAC_REFERENCE=config-agent-protocol-hmac
OPS_CONFIG_AGENT_PROTOCOL_KEY_PATH=/run/credentials/ops-config-agent.service/config-agent-protocol-hmac
OPS_CONFIG_AGENT_PROTOCOL_KEY_ID=config-agent-2026-08-31
OPS_CONFIG_AGENT_FINGERPRINT_HMAC_REFERENCE=config-agent-fingerprint-hmac
OPS_CONFIG_AGENT_FINGERPRINT_KEY_PATH=/run/credentials/ops-config-agent.service/config-agent-fingerprint-hmac
OPS_CONFIG_AGENT_FINGERPRINT_KEY_VERSION=v1
OPS_CONFIG_AGENT_STAGING_KEY_PATH=/run/credentials/ops-config-agent.service/config-agent-staging-key
OPS_CONFIG_AGENT_STAGING_KEY_ID=config-agent-staging-2026-08-31
OPS_CONFIG_AGENT_STAGING_KEY_VERSION=v1
OPS_CONFIG_AGENT_STAGING_OLD_KEY_IDS=
OPS_CONFIG_AGENT_SNAPSHOT_KEY_PATH=/run/credentials/ops-config-agent.service/config-agent-snapshot-key
OPS_CONFIG_AGENT_SNAPSHOT_KEY_ID=config-agent-snapshot-2026-08-31
OPS_CONFIG_AGENT_SNAPSHOT_KEY_VERSION=v1
OPS_CONFIG_AGENT_SNAPSHOT_OLD_KEY_IDS=
OPS_CONFIG_AGENT_MANIFEST_PATH=/srv/edutrack-ops/config-agent/current/deploy/ops/config-agent/manifest.yaml
OPS_CONFIG_AGENT_CATALOG_PATH=/srv/edutrack-ops/config-agent/current/config/variables/catalog.yaml
OPS_CONFIG_AGENT_STATE_DIRECTORY=/var/lib/edutrack-config-agent
OPS_CONFIG_AGENT_DRAFTS_DIRECTORY=/var/lib/edutrack-config-agent/drafts
OPS_CONFIG_AGENT_STAGED_DIRECTORY=/var/lib/edutrack-config-agent/staged
OPS_CONFIG_AGENT_SNAPSHOTS_DIRECTORY=/var/lib/edutrack-config-agent/snapshots
OPS_CONFIG_AGENT_LOCKS_DIRECTORY=/var/lib/edutrack-config-agent/locks
OPS_CONFIG_AGENT_DRAFT_TTL_MS=86400000
OPS_CONFIG_AGENT_STAGED_TTL_MS=86400000
OPS_CONFIG_AGENT_SNAPSHOT_RETENTION_MS=2592000000
OPS_CONFIG_AGENT_CONNECT_TIMEOUT_MS=500
OPS_CONFIG_AGENT_READ_TIMEOUT_MS=1000
OPS_CONFIG_AGENT_TOTAL_TIMEOUT_MS=2000
