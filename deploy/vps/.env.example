# Process and public URLs
NODE_ENV=production
DEPLOYMENT_STAGE=staging
HOST=127.0.0.1
PORT=3000
TZ=Asia/Ho_Chi_Minh
APP_URL=https://vps.thienuy.edu.vn
PUBLIC_BASE_URL=https://vps.thienuy.edu.vn
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
APP_COMMIT_SHA=
GLOBAL_WRITE_FREEZE=false

# PostgreSQL is the only application data backend.
DATABASE_URL=postgres://edutrack:replace-me@127.0.0.1:5432/edutrack
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_APPLICATION_NAME=edutrack-api
POSTGRES_SSL=disable
POSTGRES_BACKUP_MODE=local
POSTGRES_BACKUP_DIR=/srv/edutrack/shared/backups/postgres
POSTGRES_BACKUP_RETENTION_DAYS=14
POSTGRES_BACKUP_MAX_DISK_USAGE_PERCENT=85
POSTGRES_BACKUP_AGE_RECIPIENT=
POSTGRES_BACKUP_RCLONE_REMOTE=

# VPS-local object storage and client refresh cadence
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/srv/edutrack/shared/uploads
STORAGE_SIGNING_SECRET=
VITE_REALTIME_POLL_MS=10000

# Browser feature flags
VITE_ENABLE_ACCOUNTING_STUDENT_WORKSPACE=true
VITE_ENABLE_DIRECT_STUDENT_SNAPSHOTS=false

# PayOS (opt-in; keep both switches false while online payments are deferred)
PAYOS_ENABLED=false
VITE_PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://vps.thienuy.edu.vn/parent/tuition
PAYOS_CANCEL_URL=https://vps.thienuy.edu.vn/parent/tuition

# Cloudflare Turnstile (required)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=vps.thienuy.edu.vn

# Application secrets (generate independent random values on the VPS)
SESSION_SECRET=
CRON_SECRET=
OTP_PEPPER=
LOOKUP_CHALLENGE_SECRET=

# Native Google OAuth (optional; callback: /api/v1/auth/google-callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SMS OTP gateway (optional; Zalo reset remains available separately)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Gemini (optional unless AI/Zalo chat is enabled)
GEMINI_API_KEY=

# Zalo OA and ZNS
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=
ZALO_ZNS_TEMPLATE_ID=
ZALO_ZNS_OTP_TEMPLATE_ID=
ZALO_ZNS_EVAL_TEMPLATE_ID=
ZALO_ZNS_STAFF_TEMPLATE_ID=
ZALO_ZNS_PAYMENT_TEMPLATE_ID=
ZALO_ZNS_TUITION_NOTICE_TEMPLATE_ID=
ZALO_ZNS_NEXT_COURSE_TUITION_TEMPLATE_ID=
ZALO_ZNS_RANK_TEMPLATE_ID=

# Zalo bot
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_LINK_CODE_PEPPER=
ZALO_BOT_CHAT_HASH_SECRET=
ZALO_BOT_REQUEST_TIMEOUT_MS=10000
ZALO_BOT_ENABLED=false
ZALO_BOT_DAILY_DIGEST_ENABLED=false
ZALO_BOT_DRY_RUN=true
ZALO_BOT_CHAT_ENABLED=false
ZALO_BOT_ADMIN_DATA_ENABLED=false
ZALO_BOT_ADMIN_INTENTS_ENABLED=
ZALO_BOT_ADMIN_SNAPSHOT_REFRESH_ENABLED=false
ZALO_BOT_ADMIN_PILOT_UIDS=
ZALO_BOT_ADMIN_READ_AUDIT_RETENTION_DAYS=90

# Migration safety controls
CANONICAL_STUDENT_READ_MODE=legacy_compare
STUDENT_IDENTITY_MAINTENANCE_REQUIRED=false
