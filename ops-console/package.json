{
  "name": "edutrack-ops-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:server": "node scripts/build-server.mjs",
