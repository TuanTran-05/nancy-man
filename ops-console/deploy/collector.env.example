NODE_ENV=production
OPS_DB_PATH=/srv/edutrack-ops/shared/ops.sqlite
OPS_APP_URL=http://127.0.0.1:3000
OPS_MONITOR_DATABASE_URL=
OPS_PM2_PID_PATH=/run/edutrack/app.pid
OPS_PM2_ERROR_LOG_PATH=/var/log/edutrack/pm2-error.log
OPS_CRON_LOG_PATH=/var/log/edutrack/cron.log
OPS_BACKUP_DIR=/var/backups/edutrack
OPS_ALERT_ZALO_BOT_TOKEN=
# Optional migration fallback; normal recipients come from the Ops Console link flow.
OPS_ALERT_ZALO_RECIPIENT_UIDS=
OPS_ZALO_RECIPIENT_KEY=
OPS_ALERT_ZALO_TIMEOUT_MS=10000
