[Unit]
Description=EduTrack Ops Console Web
After=network.target

[Service]
Type=simple
User=edutrack-ops-web
Group=edutrack-ops
EnvironmentFile=/etc/edutrack-ops/web.env
WorkingDirectory=/srv/edutrack-ops/current
ExecStart=/usr/bin/node /srv/edutrack-ops/current/dist/server/web-server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
