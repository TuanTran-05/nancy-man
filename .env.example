# Public origins for CORS and the canonical URL used by self-referential jobs.
APP_URL=https://vps.thienuy.edu.vn
PUBLIC_BASE_URL=https://vps.thienuy.edu.vn
# Used only for server-to-server self-calls and cron on a single VPS.
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
APP_COMMIT_SHA=
VITE_REALTIME_POLL_MS=10000

# Accounting UI: enabled by default. Set to false only to roll back to legacy ledger/receipt tabs.
VITE_ENABLE_ACCOUNTING_STUDENT_WORKSPACE=true

# PostgreSQL (server-only). On the VPS the app connects over localhost; never
# expose port 5432 publicly.
DATABASE_URL=postgres://edutrack:change-me@localhost:5432/edutrack
POSTGRES_POOL_MAX=10
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_CONNECT_TIMEOUT_MS=5000
POSTGRES_APPLICATION_NAME=edutrack-api
POSTGRES_SSL=disable

# VPS-local object storage (server-only)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/srv/edutrack/shared/uploads
STORAGE_SIGNING_SECRET=
SESSION_SECRET=

# Native Google OAuth (optional; callback: /api/v1/auth/google-callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Native SMS OTP gateway (optional)
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Gemini AI API key (server-only)
GEMINI_API_KEY=

# PayOS is opt-in. Keep both switches false while the feature is deferred.
PAYOS_ENABLED=false
VITE_PAYOS_ENABLED=false
# payOS Payment Gateway credentials (server-only; never expose secrets as VITE_* vars)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://vps.thienuy.edu.vn/parent/tuition
PAYOS_CANCEL_URL=https://vps.thienuy.edu.vn/parent/tuition

# Zalo OA Configuration
ZALO_OA_ACCESS_TOKEN=
ZALO_OA_ID=
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REFRESH_TOKEN=

# ZNS Template 1: Thong bao vang hoc
# Placeholders: student_name, student_id, address, date
ZALO_ZNS_TEMPLATE_ID=

# ZNS Template 2: OTP dang nhap / dat lai mat khau
# Placeholders: otp
ZALO_ZNS_OTP_TEMPLATE_ID=

# ZNS Template 3: Thu nhan xet ket khoa
# Placeholders: student_name, student_code, course_end_date, final_grade, good, bad
ZALO_ZNS_EVAL_TEMPLATE_ID=

# ZNS Template 4: Staff credentials notification
# Placeholders: name, user_name, pass_word
ZALO_ZNS_STAFF_TEMPLATE_ID=

# ZNS Template 5: Xac nhan thanh toan
# Placeholders: ten_hoc_vien, ma_hoc_vien, ten_khoa_hoc, so_tien, ma_giao_dich, ngay_thanh_toan
ZALO_ZNS_PAYMENT_TEMPLATE_ID=

# ZNS Template 6: Nhac no hoc phi tong hop cho ke toan
# Placeholders: student_name, student_code, amount, semester, due_date
ZALO_ZNS_TUITION_NOTICE_TEMPLATE_ID=

# ZNS Template 7: Thong bao hoc phi khoa moi sau nhan xet ket khoa
# Placeholders: student_name, student_code, previous_end_date, start_date, end_date, amount, due_date
ZALO_ZNS_NEXT_COURSE_TUITION_TEMPLATE_ID=

# Required in production for cron and maintenance endpoints.
CRON_SECRET=

# Server-side pepper for OTP hashing (HMAC-SHA256). Required for production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_PEPPER=

# Required in production for password-reset lookup challenge tokens.
LOOKUP_CHALLENGE_SECRET=

# Cloudflare Turnstile bot verification for login (required in production).
# VITE_TURNSTILE_SITE_KEY is public and safe for browser code.
VITE_TURNSTILE_SITE_KEY=

# TURNSTILE_SECRET_KEY is server-only and belongs in the VPS shared .env file.
TURNSTILE_SECRET_KEY=

# Optional: set to your deployed hostname, for example tuantran05.site.
TURNSTILE_EXPECTED_HOSTNAME=

# Zalo Bot Platform for private staff notifications; server-only.
ZALO_BOT_TOKEN=
ZALO_BOT_WEBHOOK_SECRET=
ZALO_BOT_LINK_CODE_PEPPER=
ZALO_BOT_CHAT_HASH_SECRET=
ZALO_BOT_REQUEST_TIMEOUT_MS=10000
ZALO_BOT_ENABLED=false
ZALO_BOT_DAILY_DIGEST_ENABLED=false
ZALO_BOT_DRY_RUN=true
# Bật hỏi đáp AI qua Zalo Bot. Cần GEMINI_API_KEY khi bật.
ZALO_BOT_CHAT_ENABLED=false

# Zalo Bot Admin Data Assistant (Read-only data query for admins)
ZALO_BOT_ADMIN_DATA_ENABLED=false
# Danh sách capabilities intent được bật (cách nhau bởi dấu phẩy, để trống để tắt tất cả intent admin mới)
# Ví dụ: admin_student_lookup,admin_student_phone,admin_student_tuition,admin_center_headcount,admin_center_finance,admin_class_tuition,admin_class_tuition_ranking,admin_class_course_period,admin_teacher_payroll,admin_student_academic,admin_zalo_operations
ZALO_BOT_ADMIN_INTENTS_ENABLED=
# Bật background snapshot refresh / backfill cho ranking học phí
ZALO_BOT_ADMIN_SNAPSHOT_REFRESH_ENABLED=false
# Giới hạn danh sách UID admin được phép tham gia pilot (để trống để cho phép mọi admin khi cờ bật)
ZALO_BOT_ADMIN_PILOT_UIDS=
# Thời gian lưu trữ audit log truy vấn dữ liệu nhạy cảm của admin (ngày, bắt buộc từ 30 - 365 khi ADMIN_DATA_ENABLED=true)
ZALO_BOT_ADMIN_READ_AUDIT_RETENTION_DAYS=90
