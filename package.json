    "prepare:student-profile-normalization": "tsx scripts/normalize-student-profiles.ts --prepare",
    "apply:student-profile-normalization": "tsx scripts/normalize-student-profiles.ts --apply",
    "verify:student-profile-normalization": "tsx scripts/normalize-student-profiles.ts --verify",
    "plan:student-profile-normalization-rollback": "tsx scripts/normalize-student-profiles.ts --rollback-plan",
